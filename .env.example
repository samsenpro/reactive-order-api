# Copia este archivo como .env y reemplaza los valores. Nunca subas .env al repositorio.

# Base de datos (DB_HOST lo fija docker compose a "postgres"; en local usa localhost)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reactive_orders
DB_USERNAME=postgres
DB_PASSWORD=change_me

# JWT: mínimo 32 bytes. Genera uno con: openssl rand -base64 48
JWT_SECRET=change_me_with_a_random_secret_of_at_least_32_bytes
# Validez del access token en segundos
JWT_EXPIRATION=3600

# Servicio de notificaciones (en docker compose, el mock de WireMock)
NOTIFICATION_SERVICE_URL=http://notification-service:8081

# Límite de peticiones por IP a /api/v1/auth/** (protección contra fuerza bruta)
AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW=1m

# Administrador inicial (opcional): se crea al arrancar si no existe
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Puertos publicados por docker compose
APP_PORT=8080
NOTIFICATION_PORT=8081
